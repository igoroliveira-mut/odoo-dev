{
  "name": "Odoo 19 Mutualizo",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "odoo-mut-19",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "mgesbert.python-path",
        "redhat.vscode-commons",
        "fabianlauer.vs-code-xml-format",
        "redhat.vscode-xml",
        "mechatroner.rainbow-csv",
        "ms-python.python",
        "ms-python.debugpy",
        "esbenp.prettier-vscode",
        "scapigliato.vsc-odoo-development",
        "jigar-patel.odoosnippets",
        "dotjoshjohnson.xml",
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens"
      ]
    }
  },
  "postCreateCommand": "pip install -r /workspace/extra-addons/requirements.txt && pip install -r /workspace/extra-addons/community_modules/requirements.txt"
}
